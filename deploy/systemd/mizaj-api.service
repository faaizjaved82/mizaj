[Unit]
Description=Mizaj web app (mizaj.pk)
After=network-online.target
Wants=network-online.target

[Service]
User=mizaj
Group=mizaj
WorkingDirectory=/opt/mizaj/app
EnvironmentFile=/opt/mizaj/.env
Environment=PYTHONPATH=/opt/mizaj/app/server
Environment=MIZAJ_ENV_FILE=/opt/mizaj/.env
ExecStart=/opt/mizaj/venv/bin/uvicorn mizaj.api:app --host 127.0.0.1 --port 8200 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

# Mizaj site. Installed to /etc/caddy/sites/mizaj.caddy by deploy/setup.sh
mizaj.pk {
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	@app path /api/* /p/* /report/* /order/* /pay/* /admin /admin/*
	@milan path_regexp ^/milan/[a-z0-9]{6,12}/?$
	@palm path_regexp ^/palm/[a-z0-9]{8,12}/?$
	handle @app {
		reverse_proxy 127.0.0.1:8200
	}
	handle @milan {
		reverse_proxy 127.0.0.1:8200
	}
	handle @palm {
		reverse_proxy 127.0.0.1:8200
	}
	handle {
		root * /opt/mizaj/www
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		root * /opt/mizaj/www
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
	@assets path /css/* /js/* /img/* /og/*
	header @assets Cache-Control "public, max-age=86400"
}

www.mizaj.pk {
	redir https://mizaj.pk{uri} permanent
}

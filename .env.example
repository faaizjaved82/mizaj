# Mizaj settings. Copy to /opt/mizaj/.env on the server (setup.sh does this) and fill in.
# Everything except SITE_URL/SECRET_KEY/ADMIN_TOKEN is optional: missing integrations switch themselves off.

SITE_URL=https://mizaj.pk
SECRET_KEY=            # long random string (setup.sh generates one)
ADMIN_TOKEN=           # password for https://mizaj.pk/admin (setup.sh generates one)
TZ_NAME=Asia/Karachi
MIZAJ_DATA_DIR=/opt/mizaj/data

# Owner alerts on Telegram (you can reuse your existing secretary bot token; Mizaj only sends messages)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Payments shown at checkout (manual transfer, zero fees). Fill at least one.
PAY_RAAST_ID=          # usually your mobile number registered as Raast ID
PAY_BANK_NAME=
PAY_BANK_TITLE=
PAY_BANK_IBAN=
PAY_JAZZCASH_NUMBER=
PAY_JAZZCASH_TITLE=
PAY_EASYPAISA_NUMBER=
PAY_EASYPAISA_TITLE=
AUTO_APPROVE_MANUAL=false   # true = unlock instantly on TID, verify later (faster, some fraud risk)

# Card + wallet gateway (Safepay). Leave empty until your merchant account is approved.
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=

# Diaspora USD checkout (Lemon Squeezy hosted links), e.g. full=https://mizaj.lemonsqueezy.com/buy/xxx,bundle=...
LEMONSQUEEZY_LINKS=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Email delivery of report links (resend.com, free tier is enough to start)
RESEND_API_KEY=
MAIL_FROM=Mizaj <hello@mizaj.pk>
SUPPORT_EMAIL=hello@mizaj.pk
SUPPORT_WHATSAPP=      # e.g. 923001234567 (shown on checkout and contact pages)

# AI palm reading (console.anthropic.com API key). Empty = palm reading shows "coming soon".
ANTHROPIC_API_KEY=
MIZAJ_AI_MODEL=claude-opus-5-5
AI_DAILY_CAP=400

# Analytics / ads (optional)
PUBLIC_UMAMI_ID=
PUBLIC_UMAMI_SRC=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=

# Social
SOCIALS=instagram=https://instagram.com/mizaj.pk,tiktok=https://tiktok.com/@mizaj.pk,facebook=https://facebook.com/mizaj.pk,youtube=https://youtube.com/@mizajpk
SOCIAL_START_DATE=     # YYYY-MM-DD = day 1 of the content calendar; empty = autoposter idle
SOCIAL_AUTOPOST=true
META_GRAPH_VERSION=v23.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

DRY_RUN=false
